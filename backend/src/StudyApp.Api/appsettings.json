{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:8080",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5000",
      "http://127.0.0.1:8080"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=studyapp.db"
  },
  "JwtSettings": {
    "Issuer": "StudyApp",
    "Audience": "StudyAppMobileClient"
  },
  "AiSettings": {
    "Provider": "GoogleGemini",
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE",
    "ModelId": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "OpenAi": {
      "ApiKey": "",
      "ModelId": "gpt-4o-mini",
      "BaseUrl": "https://api.openai.com/v1/chat/completions"
    }
  }
}
